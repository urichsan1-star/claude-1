{%- comment -%}
  NATURCALM · Problema / calificación del público
  Función CRO: que la clienta se auto-identifique ("esto es para mí") antes de
  ver la solución. Espeja el bloque "Para mujeres que no dejan que la edad las
  defina" de la referencia: título aspiracional + checklist de síntomas + imagen.
{%- endcomment -%}
{{ 'naturcalm.css' | asset_url | stylesheet_tag }}

<div class="nc nc-sec nc-problem"
     style="--nc-pt:{{ section.settings.padding_top_mobile }}px;--nc-pb:{{ section.settings.padding_bottom_mobile }}px;--nc-pt-d:{{ section.settings.padding_top }}px;--nc-pb-d:{{ section.settings.padding_bottom }}px;--nc-bg:{{ section.settings.bg_color }};">
  <div class="nc-wrap">
    <div class="nc-problem__grid{% if section.settings.media_position == 'left' %} nc-problem__grid--flip{% endif %}">

      <div class="nc-problem__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="nc-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="nc-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.intro != blank -%}
          <div class="nc-lead" style="margin-bottom:26px;">{{ section.settings.intro }}</div>
        {%- endif -%}

        <ul class="nc-checklist">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <span class="nc-leaf" aria-hidden="true">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10.5l4 4 8-9"/></svg>
              </span>
              <span>{{ block.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ul>

        {%- if section.settings.button_label != blank -%}
          <div style="margin-top:30px;">
            <a class="nc-btn" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
          </div>
        {%- endif -%}
      </div>

      <div class="nc-problem__media">
        <div class="nc-media nc-media--portrait">
          {%- if section.settings.image != blank -%}
            {%- assign nc_alt = section.settings.image.alt | default: section.settings.heading -%}
            {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 45vw, 100vw', widths: '400,600,800,1200', alt: nc_alt }}
          {%- else -%}
            <div class="nc-media__ph">[Imagen · mujer 45-60, luz natural, tono calmo]</div>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "🌿 NC · Problema",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Para vos, en esta etapa" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Para mujeres que no piensan poner la vida en pausa" },
    { "type": "richtext", "id": "intro", "label": "Introducción", "default": "<p>NaturCalm nació para acompañar la transición menopáusica con calma y sin sobresaltos. Si te reconocés en alguno de estos puntos, esta fórmula fue pensada para vos.</p>" },
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "select", "id": "media_position", "label": "Posición de la imagen (desktop)", "options": [ { "value": "left", "label": "Izquierda" }, { "value": "right", "label": "Derecha" } ], "default": "right" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Quiero sentirme yo otra vez" },
    { "type": "url", "id": "button_link", "label": "Link del botón" },
    { "type": "color", "id": "bg_color", "label": "Fondo", "default": "#FDF9F7" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 2, "unit": "px", "label": "Superior (desktop)", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "label": "Inferior (desktop)", "default": 90 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 120, "step": 2, "unit": "px", "label": "Superior (mobile)", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 120, "step": 2, "unit": "px", "label": "Inferior (mobile)", "default": 56 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Punto de la checklist",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "Sofocos y sudores nocturnos que aparecen sin aviso" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "🌿 NC · Problema",
      "blocks": [
        { "type": "item", "settings": { "text": "Sofocos y sudores nocturnos que aparecen sin aviso" } },
        { "type": "item", "settings": { "text": "Noches partidas: te despertás y ya no volvés a dormir" } },
        { "type": "item", "settings": { "text": "Cambios de humor, irritabilidad o ansiedad que no reconocés como tuyos" } },
        { "type": "item", "settings": { "text": "Cansancio de fondo y niebla mental durante el día" } },
        { "type": "item", "settings": { "text": "Un peso que se instaló y no responde como antes" } }
      ]
    }
  ]
}
{% endschema %}
