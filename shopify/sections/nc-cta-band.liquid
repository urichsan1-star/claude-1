{%- comment -%}
  NATURCALM · CTA de cierre
  Función CRO: última reaparición del producto + botón, con las garantías que
  bajan el riesgo percibido justo en el momento de decidir.
{%- endcomment -%}
{{ 'naturcalm.css' | asset_url | stylesheet_tag }}

<div class="nc nc-sec nc-cta"
     style="--nc-pt:{{ section.settings.padding_top_mobile }}px;--nc-pb:{{ section.settings.padding_bottom_mobile }}px;--nc-pt-d:{{ section.settings.padding_top }}px;--nc-pb-d:{{ section.settings.padding_bottom }}px;--nc-bg:{{ section.settings.bg_color }};">
  <div class="nc-wrap">
    <div class="nc-cta__inner" style="--nc-cta-bg:{{ section.settings.card_color }};">
      {%- if section.settings.image != blank -%}
        <div style="max-width:220px;margin:0 auto 26px;">
          <div class="nc-media nc-media--square" style="background:transparent;">
            {{ section.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', alt: section.settings.heading }}
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.eyebrow != blank -%}<span class="nc-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="nc-h2" style="max-width:660px;margin-left:auto;margin-right:auto;">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="nc-lead" style="max-width:560px;margin-left:auto;margin-right:auto;">{{ section.settings.text }}</div>
      {%- endif -%}

      <div class="nc-cta-group">
        <a class="nc-btn" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
        {%- if section.settings.button_note != blank -%}<span class="nc-small">{{ section.settings.button_note }}</span>{%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="nc-cta__badges">
          {%- for block in section.blocks -%}
            <span {{ block.shopify_attributes }}>
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10.5l4 4 8-9"/></svg>
              {{ block.settings.text }}
            </span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "🌿 NC · CTA final",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Empezá hoy" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Tu transición, acompañada" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Un frasco, un gesto diario y cuatro semanas de constancia. Ese es todo el compromiso que te pedimos.</p>" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Quiero mi NaturCalm" },
    { "type": "url", "id": "button_link", "label": "Link del botón" },
    { "type": "text", "id": "button_note", "label": "Nota bajo el botón", "default": "Pago seguro · [Completar: plazos de envío y política de devolución]" },
    { "type": "image_picker", "id": "image", "label": "Imagen del producto" },
    { "type": "color", "id": "bg_color", "label": "Fondo de la sección", "default": "#FBF7F0" },
    { "type": "color", "id": "card_color", "label": "Fondo de la tarjeta", "default": "#E4EADC" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Superior (desktop)", "default": 70 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Inferior (desktop)", "default": 70 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Superior (mobile)", "default": 44 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Inferior (mobile)", "default": 44 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Garantía",
      "settings": [ { "type": "text", "id": "text", "label": "Texto", "default": "Sin hormonas" } ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "🌿 NC · CTA final",
      "blocks": [
        { "type": "badge", "settings": { "text": "Fórmula sin hormonas" } },
        { "type": "badge", "settings": { "text": "Composición publicada" } },
        { "type": "badge", "settings": { "text": "Envío a todo el país" } },
        { "type": "badge", "settings": { "text": "Atención por email real" } }
      ]
    }
  ]
}
{% endschema %}
