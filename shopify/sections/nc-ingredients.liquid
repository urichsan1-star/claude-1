{%- comment -%}
  NATURCALM · Ingredientes / composición
  Función CRO: transparencia y deseo. Cada botánico se presenta como un "héroe"
  con imagen, nombre latino, tags de beneficio y una línea de por qué está.
  IMPORTANTE: no se afirma ninguna dosis ni resultado clínico. Los campos de
  dosis vienen vacíos con placeholder para que cargues los de tu ficha técnica.
{%- endcomment -%}
{{ 'naturcalm.css' | asset_url | stylesheet_tag }}

<div class="nc nc-sec nc-ing"
     style="--nc-pt:{{ section.settings.padding_top_mobile }}px;--nc-pb:{{ section.settings.padding_bottom_mobile }}px;--nc-pt-d:{{ section.settings.padding_top }}px;--nc-pb-d:{{ section.settings.padding_bottom }}px;--nc-bg:{{ section.settings.bg_color }};">
  <div class="nc-wrap">
    <div class="nc-head">
      {%- if section.settings.eyebrow != blank -%}<span class="nc-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="nc-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<div class="nc-lead">{{ section.settings.subheading }}</div>{%- endif -%}
    </div>

    <div class="nc-ing__grid">
      {%- for block in section.blocks -%}
        <article class="nc-ing__card" {{ block.shopify_attributes }}>
          <div class="nc-ing__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw', widths: '400,600,900', alt: block.settings.name }}
            {%- else -%}
              <div class="nc-media__ph">[Foto del botánico]</div>
            {%- endif -%}
          </div>
          <div class="nc-ing__body">
            {%- if block.settings.tags != blank -%}
              <div class="nc-ing__tags">
                {%- assign tag_list = block.settings.tags | split: ',' -%}
                {%- for t in tag_list -%}
                  <span class="nc-tag{% cycle '', ' nc-tag--clay', ' nc-tag--rose' %}">{{ t | strip }}</span>
                {%- endfor -%}
              </div>
            {%- endif -%}
            <h3 class="nc-h3" style="margin-bottom:2px;">{{ block.settings.name }}</h3>
            {%- if block.settings.latin != blank -%}<p class="nc-ing__latin">{{ block.settings.latin }}</p>{%- endif -%}
            <p class="nc-p">{{ block.settings.text }}</p>
            {%- if block.settings.dose != blank -%}
              <div class="nc-ing__note">
                <span class="nc-leaf" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10.5l4 4 8-9"/></svg></span>
                <span>{{ block.settings.dose }}</span>
              </div>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.note != blank -%}
      <p class="nc-stats__foot" style="margin-top:26px;">{{ section.settings.note }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="nc-cta-group">
        <a class="nc-btn" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "🌿 NC · Ingredientes",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Composición" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Botánicos elegidos uno por uno" },
    { "type": "richtext", "id": "subheading", "label": "Bajada", "default": "<p>Nada de listas infinitas. Una selección corta de plantas con historia de uso en el acompañamiento de la menopausia, combinadas para que trabajen juntas.</p>" },
    { "type": "text", "id": "note", "label": "Nota al pie", "default": "Composición y dosis exactas: completar con la ficha técnica del laboratorio antes de publicar." },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Ver la fórmula completa" },
    { "type": "url", "id": "button_link", "label": "Link del botón" },
    { "type": "color", "id": "bg_color", "label": "Fondo", "default": "#FBF7F0" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Superior (desktop)", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Inferior (desktop)", "default": 90 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Superior (mobile)", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Inferior (mobile)", "default": 56 }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingrediente",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "tags", "label": "Tags (separados por coma)", "default": "Calma, Descanso" },
        { "type": "text", "id": "name", "label": "Nombre", "default": "Ashwagandha" },
        { "type": "text", "id": "latin", "label": "Nombre botánico", "default": "Withania somnifera" },
        { "type": "textarea", "id": "text", "label": "Descripción", "default": "Adaptógeno de uso tradicional, incorporado a la fórmula por su rol en el acompañamiento del estrés cotidiano y el descanso." },
        { "type": "text", "id": "dose", "label": "Dosis por porción", "default": "[Dosis por porción — completar]" }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    {
      "name": "🌿 NC · Ingredientes",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "Ashwagandha", "latin": "Withania somnifera", "tags": "Calma, Descanso", "text": "Adaptógeno de uso tradicional. Lo incorporamos por su papel histórico en el acompañamiento del estrés sostenido y del sueño." } },
        { "type": "ingredient", "settings": { "name": "Salvia", "latin": "Salvia officinalis", "tags": "Termorregulación", "text": "Planta clásica de la herboristería europea, asociada tradicionalmente al confort térmico durante la transición menopáusica." } },
        { "type": "ingredient", "settings": { "name": "Trébol rojo", "latin": "Trifolium pratense", "tags": "Equilibrio", "text": "Fuente vegetal de isoflavonas, incluida por su vínculo tradicional con el equilibrio femenino en esta etapa." } },
        { "type": "ingredient", "settings": { "name": "Shatavari", "latin": "Asparagus racemosus", "tags": "Vitalidad femenina", "text": "Raíz de uso ancestral en la tradición ayurvédica, elegida por su asociación histórica con el bienestar femenino." } },
        { "type": "ingredient", "settings": { "name": "Melisa", "latin": "Melissa officinalis", "tags": "Ánimo, Noche", "text": "Hoja de aroma suave, tradicionalmente usada al final del día para acompañar la calma y el descanso." } },
        { "type": "ingredient", "settings": { "name": "Magnesio", "latin": "Bisglicinato de magnesio", "tags": "Energía, Músculo", "text": "Forma de magnesio de alta tolerancia digestiva, que contribuye al funcionamiento normal del sistema nervioso y muscular." } }
      ]
    }
  ]
}
{% endschema %}
