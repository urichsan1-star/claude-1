{%- comment -%}
  NATURCALM · Tabla comparativa
  Función CRO: eliminar la objeción "¿por qué esto y no cualquier suplemento?"
  justo antes de un CTA. Espeja "La diferencia de Osh".
{%- endcomment -%}
{{ 'naturcalm.css' | asset_url | stylesheet_tag }}

<div class="nc nc-sec nc-cmp-sec"
     style="--nc-pt:{{ section.settings.padding_top_mobile }}px;--nc-pb:{{ section.settings.padding_bottom_mobile }}px;--nc-pt-d:{{ section.settings.padding_top }}px;--nc-pb-d:{{ section.settings.padding_bottom }}px;--nc-bg:{{ section.settings.bg_color }};">
  <div class="nc-wrap nc-wrap--narrow">
    <div class="nc-head">
      {%- if section.settings.eyebrow != blank -%}<span class="nc-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="nc-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<div class="nc-lead">{{ section.settings.subheading }}</div>{%- endif -%}
    </div>

    <div class="nc-cmp">
      <div class="nc-cmp__head">
        <div class="nc-cmp__spacer"></div>
        <div class="nc-cmp__brand">{{ section.settings.brand_label }}</div>
        <div class="nc-cmp__other">{{ section.settings.other_label }}</div>
      </div>
      {%- for block in section.blocks -%}
        <div class="nc-cmp__row" {{ block.shopify_attributes }}>
          <div class="nc-cmp__label">{{ block.settings.label }}</div>
          <div class="nc-cmp__cell nc-cmp__cell--brand">
            {%- if block.settings.brand_has -%}
              <span class="nc-cmp__yes" aria-label="Sí"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10.5l4 4 8-9"/></svg></span>
            {%- else -%}
              <span class="nc-cmp__no" aria-label="No"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 5l10 10M15 5L5 15"/></svg></span>
            {%- endif -%}
          </div>
          <div class="nc-cmp__cell">
            {%- if block.settings.other_has -%}
              <span class="nc-cmp__yes" aria-label="Sí"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10.5l4 4 8-9"/></svg></span>
            {%- else -%}
              <span class="nc-cmp__no" aria-label="No"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 5l10 10M15 5L5 15"/></svg></span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="nc-cta-group">
        <a class="nc-btn" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
        {%- if section.settings.button_note != blank -%}
          <span class="nc-small">{{ section.settings.button_note }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "🌿 NC · Comparación",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "La diferencia" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Qué nos separa de un suplemento cualquiera" },
    { "type": "richtext", "id": "subheading", "label": "Bajada", "default": "<p>Una comparación honesta sobre criterios que podés verificar vos misma.</p>" },
    { "type": "text", "id": "brand_label", "label": "Columna marca", "default": "NaturCalm" },
    { "type": "text", "id": "other_label", "label": "Columna comparación", "default": "Otros" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Empezar con NaturCalm" },
    { "type": "url", "id": "button_link", "label": "Link del botón" },
    { "type": "text", "id": "button_note", "label": "Nota bajo el botón", "default": "Envío a todo el país · Cambios y devoluciones según nuestra política" },
    { "type": "color", "id": "bg_color", "label": "Fondo", "default": "#F5EFE4" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Superior (desktop)", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Inferior (desktop)", "default": 90 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Superior (mobile)", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Inferior (mobile)", "default": 56 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Fila",
      "settings": [
        { "type": "text", "id": "label", "label": "Criterio", "default": "Fórmula sin hormonas" },
        { "type": "checkbox", "id": "brand_has", "label": "NaturCalm cumple", "default": true },
        { "type": "checkbox", "id": "other_has", "label": "Otros cumplen", "default": false }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "🌿 NC · Comparación",
      "blocks": [
        { "type": "row", "settings": { "label": "Fórmula sin hormonas", "brand_has": true, "other_has": false } },
        { "type": "row", "settings": { "label": "Pensada específicamente para la transición menopáusica", "brand_has": true, "other_has": false } },
        { "type": "row", "settings": { "label": "Composición completa publicada en la página", "brand_has": true, "other_has": false } },
        { "type": "row", "settings": { "label": "Dosis por porción visibles, sin mezclas ocultas", "brand_has": true, "other_has": false } },
        { "type": "row", "settings": { "label": "Revisada por especialistas en salud femenina", "brand_has": true, "other_has": false } },
        { "type": "row", "settings": { "label": "Sin promesas de resultados que no podemos sostener", "brand_has": true, "other_has": false } }
      ]
    }
  ]
}
{% endschema %}
