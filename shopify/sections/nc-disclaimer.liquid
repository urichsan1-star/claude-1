{%- comment -%}
  NATURCALM · Descargos y referencias
  Función legal + confianza: espeja el bloque de disclaimers de la referencia.
  Las referencias van vacías a propósito: cargá solo bibliografía real.
{%- endcomment -%}
{{ 'naturcalm.css' | asset_url | stylesheet_tag }}

<div class="nc nc-sec nc-disc"
     style="--nc-pt:{{ section.settings.padding_top_mobile }}px;--nc-pb:{{ section.settings.padding_bottom_mobile }}px;--nc-pt-d:{{ section.settings.padding_top }}px;--nc-pb-d:{{ section.settings.padding_bottom }}px;--nc-bg:{{ section.settings.bg_color }};">
  <div class="nc-wrap">
    <p class="nc-disc__title">{{ section.settings.title }}</p>
    <div class="nc-disc__body">{{ section.settings.text }}</div>

    {%- if section.settings.refs != blank -%}
      <details class="nc-disc__refs">
        <summary>{{ section.settings.refs_label }}</summary>
        <div class="nc-disc__body">{{ section.settings.refs }}</div>
      </details>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "🌿 NC · Descargos",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Información importante" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Este producto es un suplemento dietario. No es un medicamento y no está destinado a diagnosticar, tratar, curar ni prevenir ninguna enfermedad. No reemplaza una alimentación variada y equilibrada ni la consulta con un profesional de la salud. Consultá con tu médica o médico antes de incorporarlo, especialmente durante el embarazo, la lactancia, si tomás medicación o si tenés una condición diagnosticada. Mantener fuera del alcance de los niños. Conservar en un lugar fresco y seco.</p><p>[Completar con el número de registro sanitario y las leyendas obligatorias que correspondan a tu país antes de publicar.]</p>" },
    { "type": "text", "id": "refs_label", "label": "Título del desplegable", "default": "Referencias bibliográficas" },
    { "type": "richtext", "id": "refs", "label": "Referencias", "default": "<p>[Cargá acá la bibliografía real que respalda cada ingrediente de la fórmula. No incluir referencias que no hayas verificado.]</p>" },
    { "type": "color", "id": "bg_color", "label": "Fondo", "default": "#F5EFE4" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 2, "unit": "px", "label": "Superior (desktop)", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "label": "Inferior (desktop)", "default": 56 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 120, "step": 2, "unit": "px", "label": "Superior (mobile)", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 120, "step": 2, "unit": "px", "label": "Inferior (mobile)", "default": 40 }
  ],
  "presets": [ { "name": "🌿 NC · Descargos" } ]
}
{% endschema %}
