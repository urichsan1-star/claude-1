{%- comment -%}
  NATURCALM · Cómo funciona (banda oscura oliva)
  Función CRO: explicar el mecanismo de la fórmula — el "cómo" que justifica el
  precio. Espeja el bloque oscuro de la referencia: producto grande + 3 puntos.
{%- endcomment -%}
{{ 'naturcalm.css' | asset_url | stylesheet_tag }}

<div class="nc nc-sec nc-mech"
     style="--nc-pt:{{ section.settings.padding_top_mobile }}px;--nc-pb:{{ section.settings.padding_bottom_mobile }}px;--nc-pt-d:{{ section.settings.padding_top }}px;--nc-pb-d:{{ section.settings.padding_bottom }}px;--nc-bg:{{ section.settings.bg_color }};">
  <div class="nc-wrap">
    <div class="nc-mech__grid{% if section.settings.media_position == 'right' %} nc-mech__grid--flip{% endif %}">

      <div class="nc-mech__media">
        <div class="nc-media nc-media--square">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 45vw, 100vw', widths: '400,600,900,1200', alt: section.settings.image.alt | default: section.settings.heading }}
          {%- else -%}
            <div class="nc-media__ph">[Producto sobre fondo oliva · bodegón]</div>
          {%- endif -%}
        </div>
      </div>

      <div class="nc-mech__content">
        {%- if section.settings.eyebrow != blank -%}<span class="nc-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="nc-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.intro != blank -%}
          <div class="nc-lead" style="margin-bottom:26px;">{{ section.settings.intro }}</div>
        {%- endif -%}

        <div class="nc-mech__steps">
          {%- for block in section.blocks -%}
            <div class="nc-mech__step" {{ block.shopify_attributes }}>
              <span class="nc-mech__n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <h3 class="nc-h4">{{ block.settings.title }}</h3>
              <p class="nc-p">{{ block.settings.text }}</p>
            </div>
          {%- endfor -%}
        </div>

        {%- if section.settings.button_label != blank -%}
          <div style="margin-top:28px;">
            <a class="nc-btn nc-btn--light" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "🌿 NC · Cómo funciona",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Cómo está pensada la fórmula" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Tres frentes, una sola cápsula" },
    { "type": "richtext", "id": "intro", "label": "Introducción", "default": "<p>No alcanza con una planta suelta. NaturCalm combina botánicos que trabajan sobre frentes distintos de la misma etapa, para que el efecto sea de conjunto y no de parche.</p>" },
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "select", "id": "media_position", "label": "Posición de la imagen (desktop)", "options": [ { "value": "left", "label": "Izquierda" }, { "value": "right", "label": "Derecha" } ], "default": "left" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Empezar con NaturCalm" },
    { "type": "url", "id": "button_link", "label": "Link del botón" },
    { "type": "color", "id": "bg_color", "label": "Fondo", "default": "#46512F" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Superior (desktop)", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Inferior (desktop)", "default": 90 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Superior (mobile)", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Inferior (mobile)", "default": 56 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Frente de acción",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Confort térmico" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Botánicos tradicionalmente asociados a las sensaciones de calor repentino y a los sudores nocturnos." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "🌿 NC · Cómo funciona",
      "blocks": [
        { "type": "step", "settings": { "title": "Confort térmico", "text": "Plantas de uso tradicional frente a las sensaciones de calor repentino y los sudores nocturnos, para que el día y la noche se vuelvan más previsibles." } },
        { "type": "step", "settings": { "title": "Calma y descanso", "text": "Adaptógenos y botánicos de la tradición herbolaria que acompañan el estrés sostenido y ayudan a preparar el cuerpo para dormir." } },
        { "type": "step", "settings": { "title": "Energía sostenida", "text": "Magnesio y cofactores que contribuyen al funcionamiento normal del sistema nervioso, para sostener la energía sin estimulantes." } }
      ]
    }
  ]
}
{% endschema %}
